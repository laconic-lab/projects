#!/usr/bin/env bash
# Targeted NVIDIA backup. Reads protected paths using sudo; does not restore/change them.
# Usage: bash nvidia-backup.sh [optional-exact-path-to-secureupdate]
set -Eeuo pipefail
umask 077
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
BACKUP_DIR="$PROJECT_DIR/backups"
mkdir -p "$BACKUP_DIR"
command -v sudo >/dev/null || { echo "sudo is required" >&2; exit 1; }
OPTIONAL="${1:-}"
if [ -n "$OPTIONAL" ] && [ ! -f "$OPTIONAL" ]; then echo "Not a regular file: $OPTIONAL" >&2; exit 1; fi
STAMP="$(date +%Y%m%d-%H%M%S)"
STAGE="$(mktemp -d "$BACKUP_DIR/.stage-$STAMP.XXXXXX")"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/system-state" "$STAGE/config"
echo "Collecting system state..."
uname -a > "$STAGE/system-state/uname.txt"
cat /proc/cmdline > "$STAGE/system-state/proc-cmdline.txt" 2>/dev/null || true
dkms status > "$STAGE/system-state/dkms-status.txt" 2>&1 || true
apt-mark showhold > "$STAGE/system-state/apt-holds.txt" 2>&1 || true
dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package} ${Version}\n' 2>/dev/null | grep -Ei 'nvidia|libnvidia' > "$STAGE/system-state/nvidia-packages.txt" || true
cat /proc/driver/nvidia/version > "$STAGE/system-state/loaded-nvidia-version.txt" 2>&1 || true
modinfo -F version nvidia > "$STAGE/system-state/modinfo-version.txt" 2>&1 || true
modinfo -n nvidia > "$STAGE/system-state/modinfo-path.txt" 2>&1 || true
echo "Copying selected protected paths..."
for p in /etc/modprobe.d /etc/X11/xorg.conf /etc/default/grub /var/lib/nvidia /usr/src/nvidia-470.256.02; do
 if sudo test -e "$p"; then sudo cp -a --parents "$p" "$STAGE"
 else echo "Not present: $p" >> "$STAGE/system-state/missing-paths.txt"; fi
done
if [ -n "$OPTIONAL" ]; then cp -p -- "$OPTIONAL" "$STAGE/config/secureupdate"; fi
cat > "$STAGE/README.txt" <<EOF
Targeted NVIDIA recovery backup
Created: $(date --iso-8601=seconds 2>/dev/null || date)
Host: $(hostname)
This is a preservation snapshot, not an automated restore package.
Do not blindly restore the installer database or run the NVIDIA uninstaller.
Review docs/03-backup-and-recovery-plan.md before recovery.
EOF
ARCHIVE="$BACKUP_DIR/nvidia-recovery-$STAMP.tar.gz"
tar -czf "$ARCHIVE" -C "$STAGE" .
chmod 600 "$ARCHIVE"
echo "Backup created: $ARCHIVE"
echo "Archive size: $(du -h "$ARCHIVE" | awk '{print $1}')"
echo "Archive listing check:"
tar -tzf "$ARCHIVE" | sed -n '1,100p'
echo "Backup complete. No driver/package/configuration changes performed."
