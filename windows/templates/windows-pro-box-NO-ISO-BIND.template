#!/usr/bin/env bash
###############################################################################
# WINDOWS 11 PRO — NO ISO BIND RUNTIME START SCRIPT
# Steam Deck OLED / SteamOS host / user deck / rootless Podman
#
# PURPOSE
#   Start the existing Windows 11 Pro guest from its persistent project disk.
#   If the container object does not exist, create it WITHOUT starting it,
#   verify its complete configuration, then start it.
#
# TOP-PRIORITY RULE — NO ISO BIND
#   Normal runtime MUST NOT mount installation media.
#   This script contains no ISO source variable, ISO file test, or ISO volume
#   argument. Its only permitted bind mounts are:
#       PROJECT/storage -> /storage
#       PROJECT/shared  -> /shared
#
#   /custom.iso is checked only as a forbidden container mount destination.
#   If it exists, this script FAILS CLOSED and never starts the container.
#
# SAFETY
#   - Run as host user deck, never sudo/root.
#   - Never removes containers or project data.
#   - Never uses podman run (which would start before post-create inspection).
#   - Creates with podman create, verifies, then starts.
#   - Refuses unexpected mounts, image, restart policy, ports or state.
#   - Refuses to share the guest storage with another container.
#   - Does not print the protected environment file or its secrets.
###############################################################################

set -euo pipefail
umask 077

# ---------------------------------------------------------------------------
# 1. FIXED PROJECT IDENTITY
# ---------------------------------------------------------------------------

PROJECT="/home/deck/Windows11ProVM"
NAME="windows-pro-box"
ENV_FILE="$PROJECT/config/${NAME}.env"
STORAGE="$PROJECT/storage"
SHARED="$PROJECT/shared"

IMAGE="docker.io/dockurr/windows@sha256:59f8bed19cfd49cf1701debe34f9df6311e61a4e2ae68aa9f41206e2184e31cc"

HOST_IP="192.168.1.161"
WEB_PORT="8006"
RDP_PORT="3389"
STOP_TIMEOUT="120"

# ---------------------------------------------------------------------------
# 2. BASIC PREFLIGHT — READ-ONLY
# ---------------------------------------------------------------------------

echo "===== WINDOWS PRO — NO ISO BIND RUNTIME GATE ====="

if [[ "$(id -un)" != "deck" ]]; then
    echo "ERROR: Run this script as host user deck, not root." >&2
    exit 1
fi

for path in "$PROJECT" "$PROJECT/config" "$STORAGE" "$SHARED"; do
    if [[ ! -d "$path" ]]; then
        echo "ERROR: Required project directory is missing: $path" >&2
        exit 1
    fi
done

if [[ ! -r "$ENV_FILE" ]]; then
    echo "ERROR: Protected environment file is missing or unreadable: $ENV_FILE" >&2
    exit 1
fi

if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    echo "ERROR: /dev/kvm is not readable and writable by deck." >&2
    exit 1
fi

if ! podman image exists "$IMAGE"; then
    echo "ERROR: Pinned image is not available locally; no pull attempted." >&2
    exit 1
fi

echo "Project directories: present"
echo "Protected environment file: readable (contents not displayed)"
echo "Pinned image: available"
echo "KVM access: verified"

# ---------------------------------------------------------------------------
# 3. SHARED-STORAGE EXCLUSION GATE
#    No other container, even an exited one, may reference this guest disk.
# ---------------------------------------------------------------------------

check_storage_exclusivity() {
    local id name mounts

    while IFS= read -r id; do
        [[ -n "$id" ]] || continue

        name="$(podman inspect "$id" --format '{{.Name}}')"
        name="${name#/}"

        [[ "$name" == "$NAME" ]] && continue

        mounts="$(podman inspect "$id" --format \
            '{{range .Mounts}}{{println .Source}}{{end}}')"

        if grep -Fxq "$STORAGE" <<< "$mounts"; then
            echo "ERROR: Another container references this guest storage: $name" >&2
            echo "Do not attach one Windows guest disk to two containers." >&2
            exit 1
        fi
    done < <(podman ps -aq)
}

check_storage_exclusivity
echo "No other container references this VM storage."

# ---------------------------------------------------------------------------
# 4. CONTAINER EXISTENCE AND STATE
# ---------------------------------------------------------------------------

CONTAINER_EXISTS=0
if podman container exists "$NAME"; then
    CONTAINER_EXISTS=1
else
    exists_status=$?
    if [[ "$exists_status" -ne 1 ]]; then
        echo "ERROR: Podman could not determine whether $NAME exists." >&2
        exit "$exists_status"
    fi
fi

if [[ "$CONTAINER_EXISTS" -eq 1 ]]; then
    STATE="$(podman inspect "$NAME" --format '{{.State.Status}}')"
    echo "Existing container state: $STATE"

    case "$STATE" in
        running|created|exited)
            ;;
        *)
            echo "ERROR: Unexpected container state '$STATE'; refusing to proceed." >&2
            exit 1
            ;;
    esac
else
    STATE="absent"
    echo "Container object is absent; a new runtime object will be created."
fi

# ---------------------------------------------------------------------------
# 5. HOST PORT GATE
#    Check actual listeners, not stale port metadata on stopped containers.
# ---------------------------------------------------------------------------

port_is_listening() {
    local port="$1"
    ss -H -ltn | awk -v suffix=":$port" '$4 ~ (suffix "$") { found=1 } END { exit !found }'
}

if [[ "$STATE" != "running" ]]; then
    for port in "$WEB_PORT" "$RDP_PORT"; do
        if port_is_listening "$port"; then
            echo "ERROR: Host TCP port $port is already listening." >&2
            echo "Inspect the listener before starting this VM." >&2
            exit 1
        fi
    done
    echo "Required host TCP ports are not currently listening."
fi

# ---------------------------------------------------------------------------
# 6. CREATE IF ABSENT — CREATE ONLY, NEVER AUTO-START
# ---------------------------------------------------------------------------

if [[ "$CONTAINER_EXISTS" -eq 0 ]]; then
    echo
    echo "===== CREATE ISO-FREE RUNTIME CONTAINER ====="

    podman create \
        --name "$NAME" \
        --pull=never \
        --restart=no \
        --stop-timeout "$STOP_TIMEOUT" \
        --device=/dev/kvm \
        --publish "$HOST_IP:$WEB_PORT:8006" \
        --publish "$HOST_IP:$RDP_PORT:3389/tcp" \
        --volume "$STORAGE:/storage:rw" \
        --volume "$SHARED:/shared:rw" \
        --env-file "$ENV_FILE" \
        "$IMAGE"

    echo "Container object created. It has not been started."
fi

# ---------------------------------------------------------------------------
# 7. MANDATORY CONFIGURATION VERIFICATION
#    This function is run after create AND immediately before every start.
# ---------------------------------------------------------------------------

verify_runtime_container() {
    local actual_image restart_policy actual_mounts expected_mounts actual_ports

    actual_image="$(podman inspect "$NAME" --format '{{.ImageName}}')"
    if [[ "$actual_image" != "$IMAGE" ]]; then
        echo "FATAL: Container image does not match the pinned image." >&2
        echo "Expected: $IMAGE" >&2
        echo "Actual:   $actual_image" >&2
        exit 1
    fi

    restart_policy="$(podman inspect "$NAME" --format '{{.HostConfig.RestartPolicy.Name}}')"
    if [[ "$restart_policy" != "no" ]]; then
        echo "FATAL: Restart policy is '$restart_policy', expected 'no'." >&2
        exit 1
    fi

    # Compare the complete mount table, not just the presence of two entries.
    # This rejects /custom.iso, extra bind mounts, wrong sources and RW changes.
    actual_mounts="$(podman inspect "$NAME" --format \
        '{{range .Mounts}}{{printf "%s\t%s\t%t\n" .Source .Destination .RW}}{{end}}' \
        | LC_ALL=C sort)"

    expected_mounts="$(printf '%s\t/storage\ttrue\n%s\t/shared\ttrue\n' \
        "$STORAGE" "$SHARED" | LC_ALL=C sort)"

    echo
    echo "===== COMPLETE ACTUAL MOUNT TABLE ====="
    if [[ -n "$actual_mounts" ]]; then
        printf '%s\n' "$actual_mounts"
    else
        echo "(no mounts reported)"
    fi

    if grep -Fq $'\t/custom.iso\t' <<< "$actual_mounts"; then
        echo "FATAL: Forbidden /custom.iso mount detected. Container will NOT start." >&2
        exit 1
    fi

    if [[ "$actual_mounts" != "$expected_mounts" ]]; then
        echo "FATAL: Complete mount table does not exactly match the two approved mounts." >&2
        echo "Expected only:" >&2
        printf '  %s -> /storage (RW=true)\n  %s -> /shared (RW=true)\n' \
            "$STORAGE" "$SHARED" >&2
        echo "Do not start this container. Inspect it manually." >&2
        exit 1
    fi

    actual_ports="$(podman inspect "$NAME" --format '{{json .HostConfig.PortBindings}}')"
    echo
    echo "===== CONFIGURED HOST PORT BINDINGS ====="
    printf '%s\\n' "$actual_ports"

    python3 - "$actual_ports" "$HOST_IP" "$WEB_PORT" "$RDP_PORT" <<'PORTCHECK'
import json
import sys

raw, host_ip, web_port, rdp_port = sys.argv[1:]

try:
    actual = json.loads(raw)
except json.JSONDecodeError as exc:
    print(f"FATAL: Cannot parse Podman port bindings: {exc}", file=sys.stderr)
    sys.exit(1)

expected = {
    "8006/tcp": [{"HostIp": host_ip, "HostPort": web_port}],
    "3389/tcp": [{"HostIp": host_ip, "HostPort": rdp_port}],
}

if actual != expected:
    print("FATAL: Port bindings do not exactly match the approved configuration.", file=sys.stderr)
    print(f"Expected: {json.dumps(expected, sort_keys=True)}", file=sys.stderr)
    print(f"Actual:   {json.dumps(actual, sort_keys=True)}", file=sys.stderr)
    sys.exit(1)

print("Verified exact Web Console and RDP host port bindings.")
PORTCHECK

    echo
    echo "Verified Web Console and RDP port mappings"
}

verify_runtime_container

# ---------------------------------------------------------------------------
# 8. PRE-START GATE
#    A running container is left untouched. A created/exited one is rechecked
#    immediately before start. No start occurs if any check fails.
# ---------------------------------------------------------------------------

STATE="$(podman inspect "$NAME" --format '{{.State.Status}}')"

if [[ "$STATE" == "running" ]]; then
    echo
    echo "$NAME is already running; no start command was issued."
    exit 0
fi

if [[ "$STATE" != "created" && "$STATE" != "exited" ]]; then
    echo "ERROR: State changed to '$STATE'; refusing to start." >&2
    exit 1
fi

echo
echo "===== FINAL PRE-START VERIFICATION ====="
verify_runtime_container

# Re-read state after verification to avoid starting an unexpectedly changed object.
STATE="$(podman inspect "$NAME" --format '{{.State.Status}}')"
if [[ "$STATE" != "created" && "$STATE" != "exited" ]]; then
    echo "ERROR: Container state changed to '$STATE'; refusing to start." >&2
    exit 1
fi

echo
echo "===== START WINDOWS 11 PRO ====="
podman start "$NAME"

FINAL_STATE="$(podman inspect "$NAME" --format '{{.State.Status}}')"
if [[ "$FINAL_STATE" != "running" ]]; then
    echo "ERROR: Podman did not report the container as running." >&2
    exit 1
fi

echo
echo "SUCCESS: $NAME is running."
echo "Web Console: http://$HOST_IP:$WEB_PORT/"
echo "RDP target:  $HOST_IP:$RDP_PORT"
echo "Normal runtime has no installation ISO bind."
