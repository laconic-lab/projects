
###############################################################################
# WINDOWS 11 PRO 25H2 — NEW VM PREPARATION
# Steam Deck host / user deck / rootless Podman
#
# Creates:
#   /home/deck/Windows11ProVM/
#       config/
#       storage/
#       shared/
#       docs/
#
# Creates protected environment file and an unstarted installation container.
# Does NOT start Windows Setup.
# Does NOT modify windows-box or any existing guest storage.
###############################################################################

set -euo pipefail
umask 077

# ---------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTIFIERS
# ---------------------------------------------------------------------------

PROJECT="/home/deck/Windows11ProVM"
CONTAINER="windows-pro-box"

CONFIG="$PROJECT/config"
STORAGE="$PROJECT/storage"
SHARED="$PROJECT/shared"
DOCS="$PROJECT/docs"

ENV_FILE="$CONFIG/windows-pro-box.env"

ISO="$HOME/Downloads/26200.9974_win11pro-updates-included/26200.9974.261109-0904.25H2_GE_RELEASE_SVC_PROD1_CLIENTPRO_OEMRET_X64FRE_EN-US.ISO"

IMAGE="docker.io/dockurr/windows@sha256:59f8bed19cfd49cf1701debe34f9df6311e61a4e2ae68aa9f41206e2184e31cc"

HOST_IP="192.168.1.161"
WEB_PORT="8006"
RDP_PORT="3389"

# ---------------------------------------------------------------------------
# 2. SAFETY PREFLIGHT — NO CHANGES
# ---------------------------------------------------------------------------

echo "===== IDENTITY ====="

if [[ "$(id -un)" != "deck" ]]; then
    echo "ERROR: Run this command as host user deck, not root."
    exit 1
fi

echo "User: $(id -un)"

echo
echo "===== PROJECT COLLISION ====="

if [[ -e "$PROJECT" ]]; then
    echo "ERROR: Project directory already exists:"
    echo "$PROJECT"
    echo "Inspect it before proceeding. Nothing was overwritten."
    exit 1
fi

if podman container exists "$CONTAINER"; then
    echo "ERROR: Container already exists: $CONTAINER"
    exit 1
fi

echo "Project path and container name are available."

echo
echo "===== EXISTING WINDOWS VM ====="

if podman container exists windows-box; then
    OLD_STATE="$(podman inspect windows-box --format '{{.State.Status}}')"
    echo "windows-box state: $OLD_STATE"

    if [[ "$OLD_STATE" == "running" ]]; then
        echo "ERROR: Existing Windows VM is running."
        echo "Shut it down deliberately before proceeding with this deployment."
        exit 1
    fi
else
    echo "Existing windows-box container not found; verify project inventory."
    exit 1
fi

echo
echo "===== INSTALLATION ISO ====="

if [[ ! -r "$ISO" ]]; then
    echo "ERROR: Pro installation ISO is not readable:"
    echo "$ISO"
    exit 1
fi

ISO_SIZE="$(stat -c '%s' "$ISO")"

if [[ "$ISO_SIZE" != "8243562496" ]]; then
    echo "ERROR: ISO size differs from the audited file."
    echo "Expected: 8243562496 bytes"
    echo "Actual:   $ISO_SIZE bytes"
    exit 1
fi

echo "ISO verified: $ISO"
echo "Size: $ISO_SIZE bytes"

echo
echo "===== PINNED IMAGE ====="

if ! podman image exists "$IMAGE"; then
    echo "ERROR: Pinned Dockur image is not available locally."
    echo "No image pull or package installation was attempted."
    exit 1
fi

echo "Pinned Dockur image is available."

echo
echo "===== KVM ====="

if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
    echo "ERROR: /dev/kvm is not readable and writable by deck."
    exit 1
fi

echo "/dev/kvm access verified."

echo
echo "===== HOST PORTS ====="

LISTENERS="$(ss -ltnH)"

if grep -E "(:${WEB_PORT}|:${RDP_PORT})$" <<< "$LISTENERS"; then
    echo "ERROR: A required host TCP port is already listening."
    echo "Inspect the listener before proceeding."
    exit 1
fi

echo "TCP $WEB_PORT and TCP $RDP_PORT have no detected listeners."

# ---------------------------------------------------------------------------
# 3. CREATE UNIQUE PROJECT STRUCTURE
# ---------------------------------------------------------------------------

echo
echo "===== CREATE PROJECT DIRECTORIES ====="

mkdir -p "$CONFIG" "$STORAGE" "$SHARED" "$DOCS"
chmod 700 "$PROJECT" "$CONFIG" "$STORAGE" "$SHARED" "$DOCS"

# ---------------------------------------------------------------------------
# 4. WINDOWS ACCOUNT IDENTITY
# ---------------------------------------------------------------------------

echo
echo "===== WINDOWS ACCOUNT ====="

read -r -p "Enter the actual Windows local account name: " WIN_USER

if [[ ! "$WIN_USER" =~ ^[A-Za-z0-9._-]{1,20}$ ]]; then
    echo "ERROR: Use 1-20 characters: letters, numbers, dot, underscore or hyphen."
    exit 1
fi

# Generate a unique password locally. Never display it.
if ! command -v openssl >/dev/null 2>&1; then
    echo "ERROR: openssl is unavailable. No password was generated."
    exit 1
fi

VM_PASSWORD="$(openssl rand -hex 24)"

# ---------------------------------------------------------------------------
# 5. CREATE PROTECTED ENVIRONMENT FILE
# ---------------------------------------------------------------------------

echo
echo "===== CREATE ENVIRONMENT FILE ====="

cat > "$ENV_FILE" <<EOF
# Windows 11 Pro 25H2 — windows-pro-box
# Local secret-bearing configuration. Never commit this file.

VERSION=11

LANGUAGE=en-US
REGION=fr-FR
KEYBOARD=fr-FR

USERNAME=$WIN_USER
PASSWORD=$VM_PASSWORD
AUTOLOGIN=Y
HOST=windeck-home

CPU_CORES=4
RAM_SIZE=8G
RAM_CHECK=Y
KVM=Y

DISK_SIZE=72G
DISK_FMT=raw
ALLOCATE=N

NETWORK=user
USER_PORTS=3389

DISPLAY=web
WIDTH=1920
HEIGHT=1080
WEB=Y
WEB_PORT=8006
PROTECT=N

SAMBA=Y
EOF

unset VM_PASSWORD
chmod 600 "$ENV_FILE"

# ---------------------------------------------------------------------------
# 6. CREATE TEMPORARY INSTALLATION CONTAINER
# ---------------------------------------------------------------------------

echo
echo "===== CREATE INSTALLATION CONTAINER ====="

podman create \
    --name "$CONTAINER" \
    --pull=never \
    --restart=no \
    --stop-timeout 120 \
    --device=/dev/kvm \
    --publish "$HOST_IP:$WEB_PORT:8006" \
    --publish "$HOST_IP:$RDP_PORT:3389/tcp" \
    --volume "$STORAGE:/storage:rw" \
    --volume "$SHARED:/shared:rw" \
    --volume "$ISO:/custom.iso:ro" \
    --env-file "$ENV_FILE" \
    "$IMAGE"

# ---------------------------------------------------------------------------
# 7. REPORT — NO START
# ---------------------------------------------------------------------------

echo
echo "===== PROJECT PERMISSIONS ====="

stat -c '%A %a %U:%G %n' \
    "$PROJECT" \
    "$CONFIG" \
    "$STORAGE" \
    "$SHARED" \
    "$DOCS" \
    "$ENV_FILE"

echo
echo "===== CONTAINER STATE ====="

podman inspect "$CONTAINER" --format \
    'Name={{.Name}} State={{.State.Status}} Restart={{.HostConfig.RestartPolicy.Name}}'

echo
echo "===== CONTAINER MOUNTS ====="

podman inspect "$CONTAINER" --format \
    '{{range .Mounts}}{{println .Source "->" .Destination "RW=" .RW}}{{end}}'

echo
echo "===== PORT PUBLICATION ====="

podman inspect "$CONTAINER" --format \
    '{{json .HostConfig.PortBindings}}'

echo
echo "===== RESULT ====="

echo "Project prepared: $PROJECT"
echo "Container created: $CONTAINER"
echo "Environment file: $ENV_FILE"
echo "Installation ISO mounted read-only at /custom.iso."
echo
echo "IMPORTANT: Container remains CREATED, not started."
echo "Inspect the output above before starting Windows Setup."
