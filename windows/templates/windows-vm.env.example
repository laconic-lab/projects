# Generic Dockur Windows VM environment template
#
# Copy to a VM-specific local file, for example:
#   /home/deck/WindowsVM/config/windows-box.env
#
# TEMPLATE ONLY. Never commit a populated .env or real credentials.
# Keep each real per-VM environment file owned by deck and mode 0600.
#
# Identity labels in project documentation:
#   container-user = host/container runtime identity
#   console-user   = optional web-console authentication identity
#   win-user       = role label for the Windows local account
# USERNAME must contain the actual Windows account name, not the role label,
# unless the literal account name "win-user" is deliberately chosen.

# Windows installation and locale
# A local ISO mounted read-only at /custom.iso takes precedence over VERSION.
VERSION=11
LANGUAGE=en-US
REGION=fr-FR
KEYBOARD=fr-FR

# Windows local account — choose an actual account name and generate a
# unique password locally before installation. PASSWORD is NOT a console
# password and the literal text "auto generated" is not a valid value.
USERNAME=CHANGE_ME_WIN_USER
PASSWORD=GENERATE_AND_SET_LOCALLY
AUTOLOGIN=Y
HOST=windeck

# Virtual hardware — proposed next-guest values.
# Recheck Steam Deck available memory before using 8G.
CPU_CORES=4
RAM_SIZE=8G
RAM_CHECK=Y
KVM=Y
DISK_SIZE=72G
DISK_FMT=raw
ALLOCATE=N

# Networking
NETWORK=user
# RDP is deferred; add guest forwarding only after that lab is resumed.
# USER_PORTS=3389

# Display / noVNC
DISPLAY=web
WIDTH=1920
HEIGHT=1080
WEB=Y
WEB_PORT=8006
PROTECT=N

# GPU acceleration is NOT enabled in this template yet.
# First verify the host render node and map the device in the local start script.
# Dockur normally uses /dev/dri/renderD128 for GPU acceleration.
# GPU=Y

# Host/guest file exchange
SAMBA=Y
# Optional read-only share:
# SAMBA_READONLY=Y

# RAM ballooning is a separate experiment, not enabled by default.
# It requires a compatible guest balloon driver and careful host-memory testing.
# BALLOONING=Y
