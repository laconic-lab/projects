# Generic Dockur Windows VM environment template
#
# Copy to a VM-specific local file, for example:
#   /home/deck/WindowsVM/config/windows-box.env
#
# This is a TEMPLATE, not a deployable configuration.
# Never commit a populated .env file or put real credentials in Git.
# Keep each real per-VM environment file owned by deck and mode 0600.
#
# Identity naming convention:
#   container-user = host/container runtime identity (not a Windows login)
#   console-user   = optional web-console authentication identity/credential
#   win-user       = Windows local account configured below
#
# Windows installation and locale
VERSION=11
LANGUAGE=en-US
REGION=en-US
KEYBOARD=fr-FR

# Windows local account (win-user)
USERNAME=CHANGE_ME_WIN_USER
PASSWORD=SET_LOCALLY_DO_NOT_COMMIT
AUTOLOGIN=Y
HOST=CHANGE_ME_WINDOWS_HOSTNAME

# Virtual hardware
CPU_CORES=CHANGE_ME
RAM_SIZE=CHANGE_ME
RAM_CHECK=Y
KVM=Y
DISK_SIZE=CHANGE_ME
DISK_FMT=raw
ALLOCATE=N

# Networking
NETWORK=user
# For Dockur user-mode networking, list guest ports that need forwarding.
# Add 3389 only when RDP is intentionally enabled and published.
# USER_PORTS=3389

# Display / noVNC
DISPLAY=web
WEB=Y
WEB_PORT=8006
# Keep disabled unless a separate console credential is deliberately chosen.
PROTECT=N

# Host/guest file exchange; this is not a database.
SAMBA=Y
# Optional: SAMBA_READONLY=Y

# Optional display defaults; set only when needed.
# WIDTH=1920
# HEIGHT=1080
